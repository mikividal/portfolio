<div class="container py-5" id="projects">
  <h2 class="text-primary-emphasis mb-4">Projects</h2>
  <div class="row g-4">
    <% @projects.each do |project| %>
      <div class="col-md-4">
        <%= link_to case project.title
              when "GloWork" then glo_work_path
              when "ShiftBuddy" then shiftbuddy_path
              else "#"
            end,
            class: "text-decoration-none d-block" do %>
          <div class="project-card position-relative overflow-hidden rounded shadow-sm">
            <%= image_tag "projects/#{project.title}.png", class: "mx-auto d-block img-fluid object-fit-contain",
    style: "max-width: 100%; min-width: 300px; max-height: 400px;", alt: "#{project.title}" %>
            <div class="overlay position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-center align-items-center text-white text-center px-3">
            <h5><%= project.title %></h5>
            <p class="small"><%= project.description %></p>
          </div>
        </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
